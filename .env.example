# ================================
# starcat-recommend-api .env.example
# ================================
# 复制此文件为 .env 并填实际值。
# .env 不会提交到 git（已在 .gitignore）。
# fly.io 部署时用 `fly secrets set` 而非 .env。

# ──────────────── 服务端口 ────────────────
PORT=5005

# ──────────────── API 鉴权白名单（必填）────────────────
# 逗号分隔多个 key；与 Starcat 客户端服务设置中的 Recommend API Key 对应。
API_KEYS=sk-starcat-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ──────────────── 自研 ServingBundle ────────────────
# v1 旧客户端与 v2 共用此模型；无 active 时返回不可用，不会访问第三方。
# 配置后开放内部发布端点；必须与客户端 API_KEYS 隔离。
MODEL_PUBLISH_KEYS=replace-with-trainer-publish-key
MODEL_REGISTRY_DIR=./data/model-registry
METRICS_STORE_FILE=./data/recommend-metrics.db
# 压缩 Bundle 最大 512 MiB。
MAX_BUNDLE_BYTES=536870912

# ──────────────── 目录外单仓内容推荐（可选）────────────────
# Bundle 包含 content_index 时启用。仅此服务读取，永远不能使用客户端查询/发布 key。
# 聚合部署对应 RECOMMEND_GITHUB_TOKENS；留空时仍可对 Bundle 目录内的冷启动源做推荐。
GITHUB_TOKENS=
